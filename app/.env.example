# Este archivo contiene SOLO la plantilla de variables.
# Duplica este archivo a .env.local o .env.production y actualiza los valores reales.

# Base de Datos (RENOVATEC)
DB_HOST=aqui_va_el_host_de_tu_base_de_datos
DB_PORT=aqui_va_el_puerto_de_tu_base_de_datos
DB_NAME=aqui_va_el_nombre_de_tu_base_de_datos
DB_USER=aqui_va_el_usuario_de_tu_base_de_datos
DB_PASSWORD=aqui_va_la_contraseña_de_tu_base_de_datos
DB_CHARSET=utf8mb4

# Base de datos (alternativa PostgreSQL)
# DB_DRIVER=pgsql
# DB_HOST=localhost
# DB_PORT=5432

# Aplicacion
APP_NAME="RENOVATEC"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/congreso

# Seguridad
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_PRODUCCION
SESSION_LIFETIME=1440

# Email (Gmail SMTP)
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=TU_CONTRASENA_DE_APLICACION_DE_16_CARACTERES
MAIL_FROM_ADDRESS=tu_correo@gmail.com
MAIL_FROM_NAME=RENOVATEC

# SMTP adicional (opcional si deseas usar variables heredadas)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Pago (si se integra)
PAYMENT_PROVIDER=stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

# Configuracion del evento
EVENT_DATE=2026-10-23
EVENT_LOCATION=Uruapan, Michoacan
REGISTRATION_DEADLINE=2026-10-10
TEAM_SIZE_MIN=1
TEAM_SIZE_MAX=5
REGISTRATION_FEE=500

# Configuracion de archivos
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png
UPLOAD_PATH=./uploads/

# Configuracion de cache
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# Logs
LOG_CHANNEL=single
LOG_LEVEL=debug

# Timezone
APP_TIMEZONE=America/Mexico_City

# Idioma
APP_LOCALE=es
APP_LOCALE_FALLBACK=en

ADMIN_RECOVERY_KEY=aqui_va_la_llave_de_recuperacion_del_panel_de_admin_en_caso_de_que_se_requiera

# Dev Password
DEV_PASSWORD="Aqui va la contraseña del panel de dev en caso de que se requiera"

# Firebase Auth
FIREBASE_API_KEY=aqui_va_tu_api_key_de_firebase
