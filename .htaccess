<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    RewriteBase /
    
    # Bloquear acceso a archivos sensibles
    <FilesMatch "\.(env|sql|log|ini|git|md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # 1. Enrutar llamadas a la API limpias
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ app/api/$1.php [L,QSA]
    
    # 2. Enrutar recursos estáticos dinámicamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(?:.*\/)?(css|js|assets)/(.*)$ public/$1/$2 [L,NC]
    
    # 3. Ignorar archivos o directorios físicos existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # 4. Enrutamiento de vistas limpias hacia public/
    RewriteRule ^$ index.html [L]
    RewriteRule ^acceso/?$ public/acceso.html [L]
    RewriteRule ^usuario/?$ public/usuario.html [L]
    RewriteRule ^tallerista/?$ public/tallerista.html [L]
    RewriteRule ^admin/?$ public/admin.html [L]
    RewriteRule ^admin-editor\.html$ public/admin-editor.html [L]
    RewriteRule ^admin-editor/?$ public/admin-editor.html [L]
    RewriteRule ^admin\.html$ public/admin.html [L]
    RewriteRule ^usuario\.html$ public/usuario.html [L]
    RewriteRule ^tallerista\.html$ public/tallerista.html [L]
    RewriteRule ^registro/?$ public/registro.html [L]
    RewriteRule ^solicitud/?$ public/solicitud.html [L]
    RewriteRule ^tramite/?$ public/tramite.html [L]
    RewriteRule ^perfil/?$ public/perfil.html [L]
    RewriteRule ^confirmacion/?$ public/confirmacion.html [L]
    RewriteRule ^validador/?$ public/validador.html [L]

    # 5. Fallback genérico al index raíz (Landing Page / Meta-Router)
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
