Options -MultiViews
RewriteEngine On

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 1. Redirigir index.html a la raíz limpia
RewriteCond %{THE_REQUEST} \s/+(?:public/)?index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2. Ocultar extensión .html visualmente para cualquier archivo (Redirección 301)
RewriteCond %{THE_REQUEST} \s/+(?:public/)?([^.]+)\.html[\s?] [NC]
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# 3. Mapeo inverso genérico: Si el navegador pide "/tallerista", internamente servir "tallerista.html"
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]
RewriteRule ^tallerista/?$ public/tallerista.html [L]
RewriteRule ^docente/?$ public/tallerista.html [L]
RewriteRule ^staff/?$ public/admin.html [L]
RewriteRule ^admin-editor/?$ public/admin-editor.html [L]
